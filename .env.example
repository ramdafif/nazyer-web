# Development defaults. Copy to .env; generate your own secret, never commit it.
APP_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite:///development.sqlite3
PUBLIC_BASE_URL=http://localhost:5000
MEDIA_ROOT=/var/lib/dj-nazyer/uploads
TRUSTED_HOSTS=localhost,127.0.0.1
PROXY_HOPS=0

# Production example (replace host, database username and password).
# APP_ENV=production
# DATABASE_URL=mysql+pymysql://nazyer_app:URL_ENCODED_PASSWORD@127.0.0.1:3306/dj_nazyer?charset=utf8mb4
# PUBLIC_BASE_URL=https://dj.example.com
# TRUSTED_HOSTS=dj.example.com
# PROXY_HOPS=1
# SECRET_KEY must be >=32 random characters; SESSION_COOKIE_SECURE is forced on.
