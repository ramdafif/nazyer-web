# Example only. Review paths/permissions before installing as a NEW unit.
# Online best-effort backup: this unit never stops the website or other services.
[Unit]
Description=DJ NAZYER database and media backup
After=network.target mysql.service

[Service]
Type=oneshot
User=nazyer
Group=www-data
WorkingDirectory=/srv/dj-nazyer/current
EnvironmentFile=/etc/dj-nazyer-backup.env
ExecStart=/srv/dj-nazyer/current/deployment/backup.sh
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/dj-nazyer
